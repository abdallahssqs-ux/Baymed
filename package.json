{
  "name": "baymed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply baymed-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply baymed-db --remote",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "dev:mail": "node scripts/dev-mail.mjs",
    "setup:local": "bash scripts/setup-local.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "lucide-react": "^1.54.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "miniflare": "^5.20261006.1-alpha",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
